# ─────────────────────────────────────────────────────────────────────────────
# MADO Checklist — environment variables
#
# Copy this file to .env and fill in every value before starting the stack.
# The application will REFUSE TO START if any required variable is missing
# or if SECRET_KEY / BOT_INTERNAL_SECRET are shorter than 32 characters.
#
# .env is listed in .gitignore — never commit the filled-in file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Password for the PostgreSQL "mado" user.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# ── Backend / JWT ─────────────────────────────────────────────────────────────
# Secret used to sign and verify JWT access tokens.  Must be >= 32 characters.
# If this leaks, all issued tokens must be considered compromised.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# ── Telegram bot ──────────────────────────────────────────────────────────────
# Token issued by @BotFather for your Telegram bot.
BOT_TOKEN=CHANGE_ME

# Shared secret between the backend and the bot service.  Must be >= 32 chars.
# Both services must use the same value.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
BOT_INTERNAL_SECRET=CHANGE_ME

# ── CORS (optional — defaults shown) ─────────────────────────────────────────
# Comma-separated list of allowed origins for the backend API.
# CORS_ORIGINS=http://localhost,http://localhost:3001,https://yourdomain.com
