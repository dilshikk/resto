# ─────────────────────────────────────────────────────────────────────────────
# MADO Checklist — environment variables
#
# Copy this file to .env and fill in every value before starting the stack.
# The application will REFUSE TO START if any required variable is missing
# or if SECRET_KEY / BOT_INTERNAL_SECRET are shorter than 32 characters.
#
# .env is listed in .gitignore — never commit the filled-in file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Password for the PostgreSQL "mado_staff" user.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# ── Backend / JWT ─────────────────────────────────────────────────────────────
# Secret used to sign and verify JWT access tokens.  Must be >= 32 characters.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# ── Telegram bot ──────────────────────────────────────────────────────────────
# Token issued by @BotFather for your Telegram bot.
BOT_TOKEN=CHANGE_ME

# Shared secret between the backend and the bot service.  Must be >= 32 chars.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
BOT_INTERNAL_SECRET=CHANGE_ME

# ── FaceID Attendance (optional) ─────────────────────────────────────────────
# Connection string for the separate FaceID PostgreSQL database.
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Example (remote VPS): postgresql+asyncpg://faceid:pass@192.168.1.100:5432/faceid_db
# Leave empty or omit to disable /api/v1/attendance/* endpoints (returns 503).
ATTENDANCE_DATABASE_URL=

# ── Google Sheets export of the attendance tabel (optional) ─────────────────
# Only runs if ATTENDANCE_DATABASE_URL above is also set.
# 1. In Google Cloud Console, create a service account, enable the Google
#    Sheets API, and download its JSON key.
# 2. Paste that JSON here as ONE line (no real line breaks).
# 3. Open your Google Sheet, click "Share", and add the service account's
#    "client_email" (from the JSON) as an Editor.
# 4. Copy the long id segment from the sheet's URL into GOOGLE_SHEET_ID.
# Leave both empty to disable the daily export.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
# GOOGLE_SHEET_ID=
# Hour (UTC) the daily export runs at. Default 02:00 UTC.
# GOOGLE_SHEETS_SYNC_HOUR_UTC=2

# ── CORS (optional — defaults shown) ─────────────────────────────────────────
# Comma-separated list of allowed origins for the backend API.
# CORS_ORIGINS=http://localhost,http://localhost:3001,https://yourdomain.com

# ── Managers' Telegram group (optional) ──────────────────────────────────────
# Group/channel ID for PDF checklist reports (starts with -100).
# MANAGERS_CHAT_ID=

# ── Automatic checklist generation (optional — defaults shown) ───────────────
# CHECKLIST_SCHEDULE_HOUR_UTC=1
# CHECKLIST_AUTO_SHIFTS=morning,afternoon,evening
