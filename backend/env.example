DATABASE_URL=postgresql+asyncpg://user:password@localhost/resto
SECRET_KEY=change-me-generate-with-secrets-token-hex-32
BOT_INTERNAL_SECRET=change-me-generate-with-secrets-token-hex-32

# Telegram bot token (from @BotFather).
# Used by the backend to push notifications directly to employees
# (e.g. approve / reject on self-registration).
# Optional: if unset, those pushes are silently skipped.
# BOT_TOKEN=1234567890:AAxxxxxx

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# ── Cookie security ───────────────────────────────────────────────────────────
# Set COOKIE_SECURE=false for local HTTP development.
# In production (HTTPS) leave at the default (true).
COOKIE_SECURE=false
# COOKIE_SAMESITE=none   # use "none" for cross-origin prod, "lax" for same-origin

# Optional overrides
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=30
# PHOTOS_DIR=/data/uploads
# APP_NAME=MADO Checklist
